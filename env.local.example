# 每日推荐弹窗配置示例文件
# 
# 使用方法：
# 1. 复制此文件为 .env.local（注意前面有个点）
# 2. 取消注释并填入你的配置
# 3. 重启开发服务器 (npm run dev)
#
# 注意：.env.local 文件不会被提交到 Git（已在 .gitignore 中忽略）

# ========== Wise ID / Wise VIP 数据库 ==========
# V1 推荐使用 Postgres（Vercel Postgres / Neon / Supabase Postgres 均可）
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# ========== Wise 登录会话 ==========
# 生成方式：openssl rand -base64 32
# AUTH_SECRET=your_auth_secret
# 本地开发：
# AUTH_URL=http://127.0.0.1:3002
# 线上：
# AUTH_URL=https://wise-invest.org
# 首批管理员邮箱，多个邮箱用英文逗号分隔
# WISE_ADMIN_EMAILS=admin@wise-invest.org

# ========== OAuth 登录 ==========
# OAuth 登录必须搭配 DATABASE_URL 使用，否则无法落库生成真实 Wise User ID。
# 本地网络无法直连 Google/GitHub 时可配置代理；线上 Vercel 通常不需要。
# AUTH_OAUTH_PROXY_URL=http://127.0.0.1:7897
# Google 回调地址：
# http://127.0.0.1:3002/api/auth/callback/google
# https://wise-invest.org/api/auth/callback/google
# Auth.js v5 推荐使用 AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET；旧变量名也兼容
# AUTH_GOOGLE_ID=your_google_client_id
# AUTH_GOOGLE_SECRET=your_google_client_secret
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
#
# GitHub 回调地址：
# http://127.0.0.1:3002/api/auth/callback/github
# https://wise-invest.org/api/auth/callback/github
# AUTH_GITHUB_ID=your_github_client_id
# AUTH_GITHUB_SECRET=your_github_client_secret
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret

# ========== 邮箱注册验证码 ==========
# V1 建议使用 Resend / Postmark / SES 等成熟邮件服务
# EMAIL_FROM=Wise Invest <login@mail.wise-invest.org>
# RESEND_API_KEY=your_resend_api_key

# ========== 飞书云文档 (解析教程/文章) ==========
# 在飞书开放平台创建应用后获取，需开通云文档读取权限
# FEISHU_APP_ID=your_app_id
# FEISHU_APP_SECRET=your_app_secret

# ========== 短链服务 (Upstash Redis) ==========
# 在 Vercel 项目设置中安装 Upstash Redis 集成后会自动注入，或从 Upstash 控制台获取
# KV_REST_API_URL=https://xxx.upstash.io
# KV_REST_API_TOKEN=xxx
# 或使用 Upstash 直连变量名：
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx

# ========== 每日推荐弹窗配置 ==========
# 格式：JSON 数组字符串，最多支持 3 个推荐项
# 
# type 可选值：
#   - "welfare": 福利类型（金色主题）
#   - "article": 文章类型（蓝色主题）
#   - "wool": 羊毛类型（绿色主题）

NEXT_PUBLIC_RECOMMENDATIONS_JSON='[{"type":"welfare","title":"长期福利活动","desc":"参与即可获得丰厚奖励，长期有效","link":"https://example.com/welfare","tag":"长期福利"},{"type":"article","title":"深度好文：投资策略解析","desc":"深入分析当前市场趋势，提供专业投资建议","link":"https://example.com/article","tag":"深度好文"},{"type":"wool","title":"限时羊毛活动","desc":"限时24小时，错过不再有","link":"https://example.com/wool","tag":"限时羊毛"}]'
