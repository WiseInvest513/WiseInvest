generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MembershipTier {
  MEMBER
  VIP
  VIP_PLUS
}

enum UserRole {
  USER
  ADMIN
}

enum PartnerType {
  BROKERAGE
  EXCHANGE
  OTHER
}

enum VerificationMode {
  MANUAL
  IMPORTED_RECORD
  PARTNER_REPORT
  API
}

enum PartnerAccountStatus {
  NOT_CONNECTED
  PENDING
  VERIFIED
  REJECTED
  NEEDS_REVIEW
}

enum ContentItemType {
  ARTICLE
  ROADMAP_DETAIL
  ROADMAP_ROUTE
}

enum ContentAccessLevel {
  PUBLIC
  MEMBER
  VIP
  VIP_PLUS
}

enum ContentEventType {
  VIEW
  PREVIEW_LOCKED
  LOGIN_PROMPT
  FAVORITE_ADD
  FAVORITE_REMOVE
}

enum QualificationMetricType {
  TRADING_VOLUME
  DEPOSIT_AMOUNT
  ACCOUNT_AGE_DAYS
  MANUAL_SCORE
}

enum QualificationMetricSource {
  ADMIN
  IMPORT
  PARTNER_API
  USER_SUBMITTED
}

enum AuditAction {
  USER_CREATED
  PARTNER_ACCOUNT_SUBMITTED
  PARTNER_ACCOUNT_APPROVED
  PARTNER_ACCOUNT_REJECTED
  PARTNER_ACCOUNT_NEEDS_REVIEW
  MEMBERSHIP_UPGRADED
  MEMBERSHIP_DOWNGRADED
  ENTITLEMENT_GRANTED
  ENTITLEMENT_REVOKED
  PARTNER_CREATED
  PARTNER_UPDATED
  SSO_CLIENT_CREATED
  SSO_CLIENT_UPDATED
  CONTENT_PERMISSION_UPDATED
}

model User {
  id             String         @id @default(cuid())
  wiseUserId     String         @unique @map("wise_user_id")
  name           String?
  email          String?        @unique
  emailVerified  DateTime?      @map("email_verified")
  image          String?
  wechatId       String?        @map("wechat_id")
  passwordHash   String?        @map("password_hash") @db.Text
  membershipTier MembershipTier @default(MEMBER) @map("membership_tier")
  role           UserRole       @default(USER)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  accounts             Account[]
  sessions             Session[]
  partnerAccounts      PartnerAccount[]      @relation("UserPartnerAccounts")
  verifiedAccounts     PartnerAccount[]      @relation("VerifiedPartnerAccounts")
  qualificationMetrics QualificationMetric[]
  entitlements         Entitlement[]
  actedAuditLogs       AuditLog[]            @relation("ActorAuditLogs")
  targetAuditLogs      AuditLog[]            @relation("TargetAuditLogs")
  createdSsoClients    SsoClient[]           @relation("CreatedSsoClients")
  updatedSsoClients    SsoClient[]           @relation("UpdatedSsoClients")
  ssoAuthorizationCodes SsoAuthorizationCode[]
  updatedContentRules   ContentPermission[]   @relation("UpdatedContentPermissions")
  contentEvents         ContentEvent[]
  contentItems          UserContentItem[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("auth_verification_tokens")
}

model EmailOtp {
  id         String    @id @default(cuid())
  email      String
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@map("email_otps")
}

model Partner {
  id                     String           @id @default(cuid())
  slug                   String           @unique
  name                   String
  type                   PartnerType
  logoUrl                String?          @map("logo_url")
  referralUrl            String?          @map("referral_url")
  referralCode           String?          @map("referral_code")
  vipEligible            Boolean          @default(false) @map("vip_eligible")
  vipPlusEligible        Boolean          @default(false) @map("vip_plus_eligible")
  vipPlusVolumeThreshold Decimal?         @map("vip_plus_volume_threshold") @db.Decimal(20, 2)
  verificationMode       VerificationMode @default(MANUAL) @map("verification_mode")
  enabled                Boolean          @default(true)
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  partnerAccounts PartnerAccount[]

  @@index([type, enabled])
  @@map("partners")
}

model PartnerAccount {
  id                 String               @id @default(cuid())
  userId             String               @map("user_id")
  partnerId          String               @map("partner_id")
  externalIdentifier String               @map("external_identifier")
  status             PartnerAccountStatus @default(PENDING)
  userNote           String?              @map("user_note") @db.Text
  reviewNote         String?              @map("review_note") @db.Text
  submittedAt        DateTime             @default(now()) @map("submitted_at")
  verifiedAt         DateTime?            @map("verified_at")
  verifiedById       String?              @map("verified_by_id")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  user                 User                  @relation("UserPartnerAccounts", fields: [userId], references: [id], onDelete: Cascade)
  partner              Partner               @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  verifiedBy           User?                 @relation("VerifiedPartnerAccounts", fields: [verifiedById], references: [id], onDelete: SetNull)
  qualificationMetrics QualificationMetric[]

  @@unique([userId, partnerId, externalIdentifier])
  @@index([partnerId, status])
  @@index([userId, status])
  @@index([verifiedById])
  @@map("partner_accounts")
}

model QualificationMetric {
  id               String                    @id @default(cuid())
  userId           String                    @map("user_id")
  partnerAccountId String                    @map("partner_account_id")
  metricType       QualificationMetricType   @map("metric_type")
  value            Decimal                   @db.Decimal(20, 2)
  periodStart      DateTime?                 @map("period_start")
  periodEnd        DateTime?                 @map("period_end")
  source           QualificationMetricSource @default(ADMIN)
  verifiedAt       DateTime?                 @map("verified_at")
  createdAt        DateTime                  @default(now()) @map("created_at")

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  partnerAccount PartnerAccount @relation(fields: [partnerAccountId], references: [id], onDelete: Cascade)

  @@index([userId, metricType])
  @@index([partnerAccountId, metricType])
  @@map("qualification_metrics")
}

model Entitlement {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  key       String
  source    String
  startsAt  DateTime  @default(now()) @map("starts_at")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("entitlements")
}

model AuditLog {
  id           String      @id @default(cuid())
  actorUserId  String?     @map("actor_user_id")
  targetUserId String?     @map("target_user_id")
  action       AuditAction
  metadata     Json?
  createdAt    DateTime    @default(now()) @map("created_at")

  actorUser  User? @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser User? @relation("TargetAuditLogs", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([targetUserId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model ContentPermission {
  id          String             @id @default(cuid())
  contentType ContentItemType    @map("content_type")
  contentKey  String             @map("content_key")
  title       String
  access      ContentAccessLevel @default(MEMBER)
  reason      String             @db.Text
  updatedById String?            @map("updated_by_id")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  updatedBy User? @relation("UpdatedContentPermissions", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([contentType, contentKey])
  @@index([access])
  @@index([updatedById])
  @@map("content_permissions")
}

model ContentEvent {
  id          String           @id @default(cuid())
  userId      String?          @map("user_id")
  eventType   ContentEventType @map("event_type")
  contentType ContentItemType  @map("content_type")
  contentKey  String           @map("content_key")
  href        String
  title       String?
  metadata    Json?
  createdAt   DateTime         @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([contentType, contentKey])
  @@map("content_events")
}

model UserContentItem {
  id           String          @id @default(cuid())
  userId       String          @map("user_id")
  contentType  ContentItemType @map("content_type")
  contentKey   String          @map("content_key")
  href         String
  title        String
  summary      String?         @db.Text
  viewCount    Int             @default(0) @map("view_count")
  lastViewedAt DateTime?       @map("last_viewed_at")
  favoritedAt  DateTime?       @map("favorited_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentType, contentKey])
  @@index([userId, lastViewedAt])
  @@index([userId, favoritedAt])
  @@map("user_content_items")
}

model SsoClient {
  id                  String   @id @default(cuid())
  clientId            String   @unique @map("client_id")
  clientSecretHash    String?  @map("client_secret_hash") @db.Text
  name                String
  allowedRedirectUris String[] @map("allowed_redirect_uris")
  allowedScopes       String[] @map("allowed_scopes")
  requirePkce         Boolean  @default(true) @map("require_pkce")
  enabled             Boolean  @default(false)
  createdById         String?  @map("created_by_id")
  updatedById         String?  @map("updated_by_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  createdBy User? @relation("CreatedSsoClients", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("UpdatedSsoClients", fields: [updatedById], references: [id], onDelete: SetNull)
  authorizationCodes SsoAuthorizationCode[]

  @@index([enabled])
  @@map("sso_clients")
}

model SsoAuthorizationCode {
  id                  String    @id @default(cuid())
  codeHash            String    @unique @map("code_hash") @db.Text
  clientId            String    @map("client_id")
  userId              String    @map("user_id")
  redirectUri         String    @map("redirect_uri") @db.Text
  scope               String
  codeChallenge       String?   @map("code_challenge") @db.Text
  codeChallengeMethod String?   @map("code_challenge_method")
  nonce               String?
  expiresAt           DateTime  @map("expires_at")
  consumedAt          DateTime? @map("consumed_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  client SsoClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId, expiresAt])
  @@index([userId, createdAt])
  @@map("sso_authorization_codes")
}
